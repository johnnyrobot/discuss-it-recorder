+async function unfinishedTake (page, type, lostTrack, deviceEnded, posts, puts) {
+  // The browser encoder becomes inactive normally, but withholds every finish
+  // event. Only the recorder's watchdog can recover this take.
+  await page.evaluate(() => {
+    window.blockFinishEvents = false
+    window.finishHandlers = Object.fromEntries(['ondataavailable', 'onstop', 'onerror'].map(name => [name, Object.getOwnPropertyDescriptor(MediaRecorder.prototype, name)]))
+    for (const [name, { get, set }] of Object.entries(window.finishHandlers)) {
+      Object.defineProperty(MediaRecorder.prototype, name, {
+        configurable: true, get,
+        set (listener) { set.call(this, listener && function (event) { if (!window.blockFinishEvents) listener.call(this, event) }) }
+      })
+    }
+  })
+  await page.getByRole('button', { name: type === 'audio' ? 'Enable microphone' : 'Enable camera & microphone', exact: true }).click()
+  await page.getByRole('button', { name: 'Start recording', exact: true }).click()
+  await page.waitForTimeout(600)
+  await page.evaluate(() => { window.blockFinishEvents = true })
