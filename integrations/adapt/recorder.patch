+// Real Vue 2 adapter/core with synthetic media and intercepted upload boundaries.
+// No ADAPT server, account, real camera/microphone or object storage is used.
+import http from 'node:http'
+import fs from 'node:fs'
+import path from 'node:path'
+import assert from 'node:assert/strict'
+const { chromium, webkit } = await import(process.env.PLAYWRIGHT_MODULE || 'playwright')
+function component (file, replacements) {
+  const source = fs.readFileSync(file, 'utf8')
+  let script = source.match(/<script>([\s\S]*?)<\/script>/)[1]
+  for (const [from, to] of Object.entries(replacements)) script = script.replace(from, to)
+  return script.replace('export default', 'const component =') + `\ncomponent.template = ${JSON.stringify(source.match(/<template>([\s\S]*?)<\/template>\s*<script>/)[1])}; export default component`
+}
+const modules = {
+  '/vue.js': fs.readFileSync('node_modules/vue/dist/vue.esm.browser.js'),
+  '/axios-browser.js': fs.readFileSync('node_modules/axios/dist/axios.js'),
+  '/axios.js': 'export default window.axios',
+  '/isPhone.js': fs.readFileSync('resources/js/helpers/isPhone.js'),
+  '/Native.js': component('resources/js/components/NativeAudioVideoRecorder.vue', {
+    "from 'axios'": "from '/axios.js'",
+    "from '../helpers/isPhone'": "from '/isPhone.js'",
+    "from './recording/VideoRecorder.vue'": "from '/VideoRecorder.js'",
+    // webpack's DefinePlugin inlines this at build time; outside a bundle it has no value.
+    'process.env.ASSET_PATH': "'/'"
+  })
+}
+if (fs.existsSync('resources/js/components/recording/VideoRecorder.vue')) {
+  modules['/VideoRecorder.js'] = component('resources/js/components/recording/VideoRecorder.vue', {
+    "from '../../media/recording/Recorder'": "from '/Recorder.js'",
+    "from '../../media/recording/BackgroundImage.js'": "from '/BackgroundImage.js'"
+  })
+  for (const name of ['Recorder', 'BackgroundImage', 'BackgroundProcessor']) modules[`/${name}.js`] = fs.readFileSync(`resources/js/media/recording/${name}.js`)
+}
+let uploadCase
+const server = http.createServer((req, res) => {
+  if (req.url === '/upload') {
+    let bytes = 0
+    req.on('data', chunk => { bytes += chunk.length })
+    req.on('end', () => { uploadCase.puts.push({ type: req.headers['content-type'], bytes }); res.writeHead(uploadCase.failUpload ? 503 : 200); res.end() })
+    return
+  }
+  if (req.url.startsWith('/?')) {
+    res.setHeader('Content-Type', 'text/html')
+    res.end(`<!doctype html><div id="app"></div><script src="/axios-browser.js"></script><script type="module">
+      import Vue from '/vue.js'; import Native from '/Native.js';
+      Vue.component('b-container', { template: '<div><slot/></div>' });
+      Vue.component('b-button', { render (h) { return h('button', { on: { click: () => this.$emit('click') } }, this.$slots.default) } });
+      Vue.directive('resize', {});
+      const params = new URLSearchParams(location.search); window.events = [];
+      window.app = new Vue({ render: h => h(Native, { props: { recordingType: params.get('type'), uploadType: params.get('upload'), assignmentId: 42 },
