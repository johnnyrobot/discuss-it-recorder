+async function mediaRecorderError (page, type, whileFinishing, posts, puts) {
+  // The browser's own MediaRecorder can report an error, such as an encoder failure. What it
+  // recorded may be cut short or unplayable, so the recorder ends the take with nothing kept,
+  // whether the error arrives during the take or while it is finishing.
+  await page.evaluate(() => {
+    const start = MediaRecorder.prototype.start
+    window.restoreMediaRecorderStart = () => { MediaRecorder.prototype.start = start }
+    MediaRecorder.prototype.start = function (...args) { window.activeRecorder = this; return start.apply(this, args) }
+  })
+  await page.getByRole('button', { name: type === 'audio' ? 'Enable microphone' : 'Enable camera & microphone', exact: true }).click()
+  await page.getByRole('button', { name: 'Start recording', exact: true }).click()
+  await page.waitForTimeout(600)
+  if (whileFinishing) {
+    // Stop the take and break its MediaRecorder in the same tick, before the browser's own
+    // asynchronous stop event can resolve the take for review.
+    await page.evaluate(() => {
+      const stopButton = [...document.querySelectorAll('button')].find(button => button.textContent.trim() === 'Stop & review')
+      if (!stopButton) throw new Error('No Stop & review button')
+      stopButton.click()
+      window.activeRecorder.dispatchEvent(new Event('error'))
+    })
+  } else {
+    await page.evaluate(() => window.activeRecorder.dispatchEvent(new Event('error')))
+  }
+  await page.getByRole('button', { name: type === 'audio' ? 'Enable microphone' : 'Enable camera & microphone', exact: true }).waitFor()
+  // The host's own start() awaits the take and sets the same alert from the take's rejection
+  // a tick after the recorder's separate onError callback ('Recording failed.') settles it.
+  assert.equal(await page.getByRole('alert').innerText(), 'Recording failed. Please retake the clip.')
+  assert.equal(await page.getByLabel('Review recording', { exact: true }).count(), 0, 'A MediaRecorder error is never offered for review')
+  assert.equal(await page.getByRole('link', { name: 'Download a copy', exact: true }).count(), 0)
+  assert.equal(await page.getByRole('button', { name: 'Submit recording', exact: true }).count(), 0)
+  assert.equal(posts.length, 0, 'A failed take never asks to upload')
+  assert.equal(puts.length, 0)
+  assert.ok(await page.evaluate(() => window.captureTracks.every(track => track.readyState === 'ended')), 'A MediaRecorder error releases capture')
+  assert.deepEqual(await page.evaluate(() => window.events), [['startVideoRecording'], ['stopVideoRecording']])
+  await page.evaluate(() => { window.restoreMediaRecorderStart(); window.events = [] })
